---
import { Icon } from 'astro-icon/components';
interface Page {
	label: string;
	href: string;
	current: boolean;
}

interface Profile {
	key: string;
	label: string;
	text: string;
	href: string;
	real: boolean;
	external: boolean;
	icon: string;
}

interface Props {
	pages: Page[];
	profiles: Profile[];
}

const { pages, profiles } = Astro.props;
---

<details data-nav-menu class="group ml-auto md:hidden">
	<summary
		class="inline-flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center rounded-control px-3 font-semibold text-ink transition-colors duration-120 ease-enter select-none hover:text-accent active:bg-paper [&::-webkit-details-marker]:hidden"
	>
		<span class="sr-only">Menu</span>
		<span aria-hidden="true" class="relative block h-3.5 w-4.5">
			<span class="absolute top-0 left-0 h-0.5 w-full rounded-full bg-current transition-transform duration-200 ease-enter group-open:translate-y-1.5 group-open:rotate-45"></span>
			<span class="absolute top-1.5 left-0 h-0.5 w-full rounded-full bg-current transition-opacity duration-200 ease-enter group-open:opacity-0"></span>
			<span class="absolute top-3 left-0 h-0.5 w-full rounded-full bg-current transition-transform duration-200 ease-enter group-open:-translate-y-1.5 group-open:-rotate-45"></span>
		</span>
	</summary>

	<div
		data-nav-panel
		class="nav-panel absolute -inset-x-px top-full mt-2.25 max-h-[calc(100dvh-6rem)] overflow-y-auto overscroll-contain rounded-panel border border-rule p-2 group-open:animate-in group-open:fade-in group-open:slide-in-from-top-2 group-open:duration-200 group-open:ease-enter"
	>
		<ul>
			{
				pages.map((page) => (
					<li>
						<a
							href={page.href}
							aria-current={page.current ? 'page' : undefined}
							class="flex min-h-11 items-center border-l-2 border-transparent px-3 text-ink no-underline transition-colors duration-120 ease-enter hover:bg-paper active:bg-paper aria-[current=page]:border-accent aria-[current=page]:font-semibold aria-[current=location]:border-accent aria-[current=location]:font-semibold"
						>
							{page.label}
						</a>
					</li>
				))
			}
		</ul>
		<ul class="mt-2 border-t border-rule pt-2">
			{
				profiles.map((profile) => (
					<li>
						{profile.real ? (
							<a
								href={profile.href}
								target={profile.external ? '_blank' : undefined}
								rel={profile.external ? 'noopener noreferrer' : undefined}
								class="flex min-h-11 items-center gap-3 px-3 text-ink no-underline transition-colors duration-120 ease-enter hover:bg-paper active:bg-paper"
							>
								<Icon name={profile.icon} aria-hidden="true" focusable="false" class="size-5 shrink-0" />
								{profile.label}
								{profile.external && <span class="sr-only"> (opens in a new tab)</span>}
							</a>
						) : (
							<span class="flex min-h-11 items-center gap-3 px-3 text-ink-muted">
								<Icon name={profile.icon} aria-hidden="true" focusable="false" class="size-5 shrink-0 opacity-50" />
								{profile.text}
							</span>
						)}
					</li>
				))
			}
		</ul>
	</div>
</details>

<script>
	import '../scripts/site-nav';
</script>
