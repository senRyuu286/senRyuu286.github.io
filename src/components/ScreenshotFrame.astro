---
interface Props {
	class?: string;
	image?: string;
	imageAlt?: string;
}

const { class: className, image, imageAlt } = Astro.props;
---

<div
	class:list={['relative aspect-16/10 w-full overflow-hidden rounded-control border border-rule bg-paper', className]}
	data-card-screenshot
>
	{image ? <img src={image} alt={imageAlt ?? ''} loading="lazy" class="h-full w-full bg-[#faf6ef] object-contain" /> : <><img src="/project-preview-placeholder.png" alt="Illustration of a laptop with a code symbol" width="1586" height="992" loading="lazy" class="h-full w-full object-cover" /><span class="absolute bottom-3 left-3 rounded-control bg-paper px-3 py-1 text-meta text-ink">Illustration placeholder</span></>}
</div>
