---
import type { SkillGroup } from '../lib/skills';

interface Props {
	groups: SkillGroup[];
	class?: string;
}

const { groups, class: className } = Astro.props;
---

<dl class:list={['border-t border-rule', className]}>
	{
		groups.map((group) => (
			<div class="grid gap-1 border-b border-rule py-4 sm:grid-cols-[12rem_1fr] sm:gap-6">
				<dt class="font-semibold">{group.name}</dt>
				<dd>
					<ul class="flex flex-wrap gap-x-4 gap-y-1">
						{group.items.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				</dd>
			</div>
		))
	}
</dl>