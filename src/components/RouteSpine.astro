---
// A route spine joins a list of stops with a line. Put RouteStop components inside it.
// The spine only sets the shared sizes and keeps the stops in their own stacking layer (see global.css).
// Each stop draws its own piece of line down to the next stop, so any number of stops works.
interface Props {
	/** "div" (default) for plain sections. "ol" for a real sequence such as a journey (use RouteStop as="li" inside). */
	as?: 'div' | 'ol';
	class?: string;
	/** Extra data attributes are passed through, for example data-journey. */
	[attribute: `data-${string}`]: string | boolean | undefined;
}

const { as: Tag = 'div', class: className, ...attributes } = Astro.props;
---

<!-- role="list" keeps list meaning in Safari, which drops it when the list bullets are removed. -->
<Tag class:list={['route-spine', className]} role={Tag === 'ol' ? 'list' : undefined} data-spine {...attributes}>
	<slot />
</Tag>