---
import { nav, site } from '../lib/site';

const path = Astro.url.pathname;
---

<header class="border-b border-rule">
	<div class="mx-auto flex w-full max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-1 px-4 sm:px-6">
		<a
			href="/"
			translate="no"
			class="inline-flex min-h-11 items-center font-display text-h2 font-bold text-ink no-underline hover:text-accent"
		>
			{site.name}
		</a>
		<nav aria-label="Main">
			<ul class="flex flex-wrap gap-x-6">
				{
					nav.map((item) => (
						<li>
							<a
								href={item.href}
								aria-current={path.startsWith(item.href) ? 'page' : undefined}
								class="inline-flex min-h-11 items-center text-ink hover:text-accent aria-[current=page]:font-bold aria-[current=page]:decoration-2"
							>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>