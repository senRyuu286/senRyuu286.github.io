---
// src/components/EducationCertificates.astro
import { getCollection } from 'astro:content';
import { education } from '../lib/education';
import { isUrl } from '../lib/site';

interface Props {
	class?: string;
}

const { class: className } = Astro.props;

// Certificates come from src/content/certificates, the same files the Work list reads.
// Home shows the first four. The Work page has them all.
const certificates = await getCollection('certificates');
const shown = certificates.slice(0, 4);
const hasMore = certificates.length > shown.length;
---

<section aria-labelledby="education-heading" class={className} data-education-certificates>
	<h2 id="education-heading">Education and certificates</h2>
	<div class:list={['mt-6 grid gap-10', certificates.length > 0 && 'md:grid-cols-2']}>
		<div class="min-w-0" data-education>
			<h3 class="font-display text-body font-bold">Education</h3>
			<ul class="mt-4 border-b border-rule">
				{
					education.map((entry) => (
						<li class="border-t border-rule py-5">
							<p class="font-bold wrap-break-word">{entry.school}</p>
							<p class="wrap-break-word">{entry.program}</p>
							<p class="text-meta text-ink-muted">{entry.period}</p>
							{entry.highlights.length > 0 && (
								<ul class="mt-3 list-disc space-y-1 pl-5">
									{entry.highlights.map((item) => (
										<li class="wrap-break-word">{item}</li>
									))}
								</ul>
							)}
						</li>
					))
				}
			</ul>
		</div>
		{
			certificates.length > 0 && (
				<div class="min-w-0" data-certificates>
					<h3 class="font-display text-body font-bold">Certificates</h3>
					<ul class="mt-4 border-b border-rule">
						{shown.map(({ data }) => (
							<li class="flex gap-4 border-t border-rule py-5" data-certificate>
								{data.image && (
									<img
										src={data.image}
										alt={data.imageAlt ?? `Certificate: ${data.title}`}
										width="112"
										height="84"
										loading="lazy"
										class="h-21 w-28 shrink-0 rounded-control border border-rule bg-surface object-contain"
									/>
								)}
								<div class="min-w-0">
									<p class="font-bold wrap-break-word">{data.title}</p>
									<p class="text-meta text-ink-muted wrap-break-word">
										{data.issuer}, {data.year}
									</p>
									{data.credentialUrl && isUrl(data.credentialUrl) && (
										<p class="mt-2">
											<a href={data.credentialUrl} target="_blank" rel="noopener noreferrer">
												Verify credential
											</a>
										</p>
									)}
								</div>
							</li>
						))}
					</ul>
					{hasMore && (
						<p class="mt-4">
							<a href="/work/">See all certificates on the Work page</a>
						</p>
					)}
				</div>
			)
		}
	</div>
</section>