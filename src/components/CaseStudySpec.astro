---
import Button from './ui/Button.astro';
import Chip from './ui/Chip.astro';
import ScreenshotFrame from './ScreenshotFrame.astro';
import { isUrl } from '../lib/site';

interface Props {
	/** The technologies used, shown as chips. */
	stack: string[];
	/** Links from the content file. Real web addresses become buttons. Placeholders show as plain text, so the launch gate still catches them. */
	links: Array<{ label: string; value: string }>;
	class?: string;
}

const { stack, links, class: className } = Astro.props;
---

<div class={className}>
	<ul class="flex flex-wrap gap-2" aria-label="Stack">
		{
			stack.map((item) => (
				<li class="max-w-full min-w-0">
					<Chip>{item}</Chip>
				</li>
			))
		}
	</ul>
	{
		links.length > 0 && (
			<ul class="mt-6 flex flex-wrap gap-3" data-case-links>
				{links.map((link) => (
					<li>
						{isUrl(link.value) ? (
							<Button href={link.value} variant="secondary">
								{link.label}
							</Button>
						) : (
							<span class="inline-flex min-h-11 items-center">{link.value}</span>
						)}
					</li>
				))}
			</ul>
		)
	}
	<ScreenshotFrame class="mt-8" />
</div>