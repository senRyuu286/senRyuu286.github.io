---
import Button from './ui/Button.astro';
import { site } from '../lib/site';

// One reveal recipe for every hero line: fade in and rise 8px over 400ms.
// "fill-mode-backwards" keeps a line hidden only during its own short delay, then it is always visible.
// Reduced motion turns every animation off in global.css, so the lines are simply there.
const reveal = 'animate-in fade-in slide-in-from-bottom-2 duration-400 ease-enter fill-mode-backwards';
---

<section data-hero class="rounded-panel bg-signal p-6 text-signal-ink sm:p-12">
	<p class:list={['font-display text-h2 font-bold', reveal]} translate="no">{site.name}</p>
	<h1 class:list={['sign mt-3 wrap-break-word', reveal, 'delay-80']}>
		BSIT student building {site.focusArea}
	</h1>
	<p class:list={['mt-5', reveal, 'delay-160']}>{site.bioSentence}</p>
	<div class:list={['mt-8 flex flex-wrap gap-3', reveal, 'delay-240']}>
		<Button href="/work/" variant="sign">View my work</Button>
		<Button href="/contact/" variant="sign-outline">Contact me</Button>
	</div>
</section>