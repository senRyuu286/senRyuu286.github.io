---
import Chip from './ui/Chip.astro';
import type { SkillGroup } from '../lib/skills';

interface Props {
	groups: SkillGroup[];
	class?: string;
}

const { groups, class: className } = Astro.props;

// From 768px the tiles sit on a 5-column grid in a staggered two-column pattern:
// the first tile (yellow) is full width, then the rows alternate 3+2 columns and 2+3 columns.
// A last tile that would sit alone in its row goes full width, so 1, 3, 4, 5 or 6 groups leave no hole.
// On phones every tile is one full-width row. The class names are written out in full so Tailwind can find them.
const span = {
	full: 'md:col-span-5',
	wide: 'md:col-span-3',
	narrow: 'md:col-span-2',
};

function spanFor(index: number, total: number): string {
	if (index === 0) return span.full;
	const slot = index - 1;
	const startsRow = slot % 2 === 0;
	if (startsRow && index === total - 1) return span.full;
	const wideFirst = Math.floor(slot / 2) % 2 === 0;
	return startsRow === wideFirst ? span.wide : span.narrow;
}
---

<ul class:list={['grid gap-4 md:grid-cols-5', className]} data-tiles>
	{
		groups.map((group, index) => (
			<li
				class:list={[
					'min-w-0 rounded-panel p-4 md:p-6',
					index === 0 ? 'tile-signal bg-signal text-signal-ink' : 'border border-rule bg-surface',
					spanFor(index, groups.length),
				]}
				data-tile
			>
				<h3 class="font-display text-body font-bold wrap-break-word">{group.name}</h3>
				{group.items.length > 0 && (
					<ul class="mt-4 flex flex-wrap gap-2">
						{group.items.map((item) => (
							<li class="max-w-full min-w-0">
								<Chip>{item}</Chip>
							</li>
						))}
					</ul>
				)}
			</li>
		))
	}
</ul>