---
import type { WorkItem } from '../lib/work';

interface Props {
  items: WorkItem[];
}

const { items } = Astro.props;
---

<table role="table" class="block w-full tabular-nums sm:table">
	<caption class="sr-only">Work list: projects, certificates, and activities</caption>
	<thead role="rowgroup" class="sr-only sm:not-sr-only sm:table-header-group">
		<tr role="row">
			<th role="columnheader" scope="col" class="pb-2 pr-6 text-left text-meta font-semibold text-ink-muted">Title</th>
			<th role="columnheader" scope="col" class="pb-2 pr-6 text-left text-meta font-semibold text-ink-muted">Type</th>
			<th role="columnheader" scope="col" class="pb-2 pr-6 text-left text-meta font-semibold text-ink-muted">Year</th>
			<th role="columnheader" scope="col" class="pb-2 text-left text-meta font-semibold text-ink-muted">Status</th>
		</tr>
	</thead>
	<tbody role="rowgroup" class="block border-b border-rule sm:table-row-group">
		{
			items.map((item) => (
				<tr
					role="row"
					data-work-row
					data-type={item.type}
					data-search={item.searchText}
					class="block border-t border-rule py-4 sm:table-row sm:py-0"
				>
					<td role="cell" class="block sm:table-cell sm:w-full sm:py-4 sm:pr-6 sm:align-top">
						<p class="font-display font-bold">
							{item.href !== undefined ? (
								<a
									href={item.href}
									target={item.external ? '_blank' : undefined}
									rel={item.external ? 'noopener noreferrer' : undefined}
								>
									{item.title}
									{item.external && <span class="sr-only"> (opens in a new tab)</span>}
								</a>
							) : (
								item.title
							)}
						</p>
						{item.details.map((line) => (
							<p class="mt-1">{line}</p>
						))}
						{item.tags.length > 0 && <p class="mt-1 text-meta text-ink-muted">Tags: {item.tags.join(', ')}</p>}
					</td>
					<td role="cell" class="flex gap-3 pt-3 sm:table-cell sm:py-4 sm:pr-6 sm:align-top sm:whitespace-nowrap">
						<span class="w-14 shrink-0 text-ink-muted sm:hidden" aria-hidden="true">Type</span>
						{item.type}
					</td>
					<td role="cell" class="flex gap-3 pt-1 sm:table-cell sm:py-4 sm:pr-6 sm:align-top sm:whitespace-nowrap">
						<span class="w-14 shrink-0 text-ink-muted sm:hidden" aria-hidden="true">Year</span>
						{item.year}
					</td>
					<td role="cell" class="flex gap-3 pt-1 sm:table-cell sm:py-4 sm:align-top">
						<span class="w-14 shrink-0 text-ink-muted sm:hidden" aria-hidden="true">Status</span>
						{item.status}
					</td>
				</tr>
			))
		}
	</tbody>
</table>