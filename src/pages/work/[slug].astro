---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudySpec from '../../components/CaseStudySpec.astro';
import { site } from '../../lib/site';

export const getStaticPaths = (async () => {
	const projects = await getCollection('projects');
	return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

// Links come from the content file. Placeholders show as plain text until real addresses are added.
const links = [
	{ label: 'View code on GitHub', value: data.github },
	{ label: 'Open live demo', value: data.demo },
].filter((link): link is { label: string; value: string } => link.value !== undefined);
---

<BaseLayout title={`${data.title} | ${site.name}`} description={data.summary}>
	<article class="max-w-3xl">
		<p><a href="/work/">Back to all work</a></p>
		<h1 class="mt-6">{data.title}</h1>
		<p class="mt-3">{data.summary}</p>
		<CaseStudySpec stack={data.stack} links={links} class="mt-6" />
		<div class="project-content mt-12"><Content /></div>
	</article>
</BaseLayout>