---
// src/pages/index.astro
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import Chip from '../components/ui/Chip.astro';
import EducationCertificates from '../components/EducationCertificates.astro';
import Experiences from '../components/Experiences.astro';
import ContactForm from '../components/ContactForm.astro';
import Hero from '../components/Hero.astro';
import ScreenshotFrame from '../components/ScreenshotFrame.astro';
import TechStack from '../components/TechStack.astro';
import { isUrl, profileLinks, site } from '../lib/site';
import { skillGroups, skillIcons } from '../lib/skills';

const projects = (await getCollection('projects')).sort((a, b) =>
	a.id === 'capstone' ? -1 : b.id === 'capstone' ? 1 : a.data.title.localeCompare(b.data.title),
);
---

<BaseLayout
	title={`${site.name} | Portfolio`}
	description="Justin Ramas is an Information Technology student exploring web development and building projects."
	preloadDisplayFont
	includePerson
>
	<Hero showExplore={projects.length > 0} />
	<div class="mx-auto w-full max-w-5xl px-4 pb-12 sm:px-6">

	{
		projects.length > 0 && (
			<section aria-labelledby="works" class="selected-works mt-16">
				<h2 id="works">Selected Works</h2>
				{projects.map((capstone) => {
					const capstoneLinks = [
						{ label: 'GitHub', value: capstone.data.github, icon: 'arrow' },
						{ label: `Try ${capstone.data.title}`, value: capstone.data.demo, icon: 'external' },
					].flatMap((link) => link.value && isUrl(link.value) ? [{ ...link, value: link.value }] : []);
					return (
				<article class="selected-work" data-selected-work>
					<div class="selected-work-copy">
						<h3>{capstone.data.title}</h3>
						{capstone.data.subtitle && <p class="selected-work-subtitle">{capstone.data.subtitle}</p>}
						{capstone.data.role && <p class="selected-work-role"><span>Role:</span> {capstone.data.role}</p>}
						<ul class="selected-work-stack" aria-label="Stack">
							{capstone.data.stack.map((item) => <li><Chip icon={skillIcons[item]}>{item}</Chip></li>)}
						</ul>
						<p class="selected-work-summary">{capstone.data.summary}</p>
						{capstoneLinks.length > 0 && (
							<div class="selected-work-links">
								{capstoneLinks.map((link) => (
									<a href={link.value} target="_blank" rel="noopener noreferrer" class="group">
										{link.label}
										{link.icon === 'arrow' ? <span aria-hidden="true" class="inline-block transition-transform duration-200 ease-enter motion-safe:group-hover:translate-x-1 motion-safe:group-focus-visible:translate-x-1">&#8594;</span> : <svg class="transition-transform duration-200 ease-enter motion-safe:group-hover:translate-x-1 motion-safe:group-focus-visible:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M13 5h6v6M19 5l-9 9M19 14v5H5V5h5"></path></svg>}
										<span class="sr-only"> (opens in a new tab)</span>
									</a>
								))}
							</div>
						)}
					</div>
					<ScreenshotFrame />
				</article>
					);
				})}
			</section>
		)
	}

	<section aria-labelledby="tech-stack-heading" class="mt-16">
		<h2 id="tech-stack-heading">Tech Stack</h2>
		<TechStack groups={skillGroups} class="mt-4" />
	</section>

	<EducationCertificates class="mt-20" />
	<Experiences />
	<section id="contact" aria-labelledby="contact-heading" class="contact-section mt-20">
		<div class="contact-layout">
			<div class="contact-form-card">
				<h2 id="contact-heading">Let’s Build Something Meaningful.</h2>
				<p class="contact-intro">I’m currently learning and exploring opportunities. Feel free to reach out about collaborations or projects.</p>
				<ContactForm />
			</div>
			<div class="contact-side">
				<div class="contact-art">
					<img src="/contact-illustration.png" alt="" width="1312" height="1199" loading="lazy" />
				</div>
				<div class="contact-details">
					<h3 id="profiles-heading" class="sr-only">Find Me Online</h3>
					<ul>
						{profileLinks.map((profile) => (
							<li class="contact-detail">
								<span class="contact-detail-icon"><Icon name={`simple-icons:${profile.key}`} aria-hidden="true" focusable="false" /></span>
								<div>
									<p class="contact-detail-label">{profile.label}</p>
									{profile.real ? <a href={profile.href} target="_blank" rel="noopener noreferrer">{profile.key === 'github' ? 'SenRyuu286' : site.name}<span class="sr-only"> ({profile.label}, opens in a new tab)</span></a> : <span>{profile.text}</span>}
								</div>
							</li>
						))}
						<li class="contact-detail">
							<span class="contact-detail-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 5-8 11-8 11s-8-6-8-11a8 8 0 1 1 16 0Z"></path><circle cx="12" cy="10" r="2.5"></circle></svg></span>
							<div><p class="contact-detail-label">Location</p><p>Cebu, Philippines</p></div>
						</li>
					</ul>
				</div>
			</div>
		</div>
	</section>
	</div>
</BaseLayout>
