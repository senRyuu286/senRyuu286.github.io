---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import CaseStudySpec from '../components/CaseStudySpec.astro';
import SkillGroups from '../components/SkillGroups.astro';
import { site } from '../lib/site';
import { skillGroups } from '../lib/skills';

// The featured capstone comes from src/content/projects/capstone.md.
const capstone = await getEntry('projects', 'capstone');
---

<BaseLayout
	title={`${site.name}, BSIT student building ${site.focusArea}`}
	description={site.bioSentence}
	preloadDisplayFont
	includePerson
>
	<section class="rounded-panel bg-signal p-6 text-signal-ink sm:p-12">
		<p class="font-display text-h2 font-bold" translate="no">{site.name}</p>
		<h1 class="sign mt-3 animate-in fade-in slide-in-from-bottom-2 duration-200 ease-enter wrap-break-word">
			BSIT student building {site.focusArea}
		</h1>
		<p class="mt-5">{site.bioSentence}</p>
		<div class="mt-8 flex flex-wrap gap-3">
			<Button href="/work/" variant="sign">View my work</Button>
			<Button href="/contact/" variant="sign-outline">Contact me</Button>
		</div>
	</section>

	{
		capstone && (
			<section class="mt-12" aria-labelledby="featured-heading">
				<h2 id="featured-heading">Featured capstone</h2>
				<div class="mt-3">
					<h3 class="font-display text-body font-bold">{capstone.data.title}</h3>
					<p class="mt-2">{capstone.data.summary}</p>
					<CaseStudySpec
						role={capstone.data.role}
						stack={capstone.data.stack}
						year={capstone.data.year}
						status={capstone.data.status}
						class="mt-5"
					/>
					<Button href={`/work/${capstone.id}/`} variant="secondary" class="mt-6">
						Read the case study
					</Button>
				</div>
			</section>
		)
	}

	<section class="mt-12" aria-labelledby="skills-heading">
		<h2 id="skills-heading">Skills</h2>
		<SkillGroups groups={skillGroups} class="mt-3" />
		<p class="mt-4"><a href="/about/">See my learning journey on the About page</a></p>
	</section>

	<section class="mt-12 border-t border-rule pt-8">
		<p class="font-display text-h2 font-bold">{site.availability}</p>
		<Button href="/contact/" class="mt-5">Contact me</Button>
	</section>
</BaseLayout>