---
import '../styles/global.css';
import Button from '../components/ui/Button.astro';
import Input from '../components/ui/Input.astro';
import Textarea from '../components/ui/Textarea.astro';
import Label from '../components/ui/Label.astro';
import Toggle from '../components/ui/Toggle.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>Milestone 2 component check</title>
	</head>
	<body>
		<main class="mx-auto max-w-3xl px-4 py-12">
			<h1>Milestone 2 component check</h1>
			<p class="mt-3 text-ink-muted">
				This temporary page tests the tokens, the fonts, and the five components. Milestone 4 replaces it.
			</p>

			<section class="mt-12">
				<h2>Type</h2>
				<p class="sign mt-3">Sign text, condensed and heavy</p>
				<p class="mt-3">
					Body text in Atkinson Hyperlegible Next, with a <a href="/">link inside a sentence</a>.
				</p>
				<table class="mt-3 tabular-nums">
					<caption class="pb-2 text-left text-meta text-ink-muted">
						The digits in both rows should line up.
					</caption>
					<tbody>
						<tr><td class="pr-6">Row one</td><td class="text-right">1,111</td></tr>
						<tr><td class="pr-6">Row two</td><td class="text-right">8,888</td></tr>
					</tbody>
				</table>
			</section>

			<section class="mt-12">
				<h2>Buttons</h2>
				<div class="mt-3 flex flex-wrap gap-3">
					<Button>Send message</Button>
					<Button variant="secondary">View my work</Button>
					<Button href="/">Link button</Button>
					<Button disabled>Disabled</Button>
				</div>
			</section>

			<section class="mt-12">
				<h2>Filter chips</h2>
				<div class="mt-3 flex flex-wrap gap-3">
					<Toggle pressed>All</Toggle>
					<Toggle>Projects</Toggle>
					<Toggle>Certificates</Toggle>
					<Toggle disabled>Activities</Toggle>
				</div>
			</section>

			<section class="mt-12">
				<h2>Form fields</h2>
				<div class="mt-3 max-w-md">
					<Label for="demo-name" required>Name</Label>
					<Input id="demo-name" name="name" autocomplete="name" />
				</div>
				<div class="mt-6 max-w-md">
					<Label for="demo-email" required>Email</Label>
					<Input
						id="demo-email"
						name="email"
						type="email"
						value="not-an-email"
						aria-invalid="true"
						aria-describedby="demo-email-error"
					/>
					<p id="demo-email-error" class="mt-2 text-meta text-error">
						Enter an email address like name@example.com.
					</p>
				</div>
				<div class="mt-6 max-w-md">
					<Label for="demo-message">Message</Label>
					<Textarea id="demo-message" name="message" />
				</div>
				<div class="mt-6 max-w-md">
					<Label for="demo-disabled">Disabled field</Label>
					<Input id="demo-disabled" name="disabled" disabled value="Not editable" />
				</div>
			</section>
		</main>
	</body>
</html>