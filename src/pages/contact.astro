---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { isUrl, site } from '../lib/site';

const profiles = [
	{ label: 'LinkedIn', href: site.linkedin },
	{ label: 'GitHub', href: site.github },
];
---

<BaseLayout
	title={`Contact | ${site.name}`}
	description="Use the form to send me a message. I reply as soon as I can."
>
	<h1>Contact</h1>
	<p class="mt-3">Send me a message and I will reply as soon as I can.</p>
	<div class="mt-8">
		<ContactForm />
	</div>

	<section class="mt-12" aria-labelledby="profiles-heading">
		<h2 id="profiles-heading">Find me online</h2>
		<ul class="mt-3 flex flex-wrap gap-x-6">
			{
				profiles.map((profile) => (
					<li>
						{isUrl(profile.href) ? (
							<a
								href={profile.href}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex min-h-11 items-center"
							>
								{profile.label}
								<span class="sr-only"> (opens in a new tab)</span>
							</a>
						) : (
							<span class="inline-flex min-h-11 items-center">{profile.href}</span>
						)}
					</li>
				))
			}
		</ul>
	</section>
</BaseLayout>